<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Atlas.Core\Atlas.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LumexUI" Version="2.2.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <SkipTailwindBuild>true</SkipTailwindBuild>
  </PropertyGroup>

  <Target Name="BuildTailwindCSS" BeforeTargets="Build" DependsOnTargets="CopyContents" Condition="'$(SkipTailwindBuild)' != 'true'">
    <Exec Command="npx @tailwindcss/cli -i wwwroot/app.css -o wwwroot/app.build.css --minify" WorkingDirectory="$(ProjectDir)" />
  </Target>

</Project>
