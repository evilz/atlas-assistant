@page "/dashboard"
@using Atlas.Core
@rendermode InteractiveServer
@inject AtlasOrchestrator Orchestrator

<PageTitle>Dashboard - ATLAS Assistant</PageTitle>

<h1 class="text-2xl font-semibold mb-6">ATLAS Dashboard</h1>

<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
    <LumexCard>
        <LumexCardBody>
            <div class="text-center">
                <p class="text-3xl font-bold text-primary">@Orchestrator.GetAvailableProviders().Count()</p>
                <p class="text-default-500">Active Providers</p>
            </div>
        </LumexCardBody>
    </LumexCard>
    <LumexCard>
        <LumexCardBody>
            <div class="text-center">
                <p class="text-3xl font-bold text-success">@Orchestrator.GetAvailableSkills().Count()</p>
                <p class="text-default-500">Available Skills</p>
            </div>
        </LumexCardBody>
    </LumexCard>
    <LumexCard>
        <LumexCardBody>
            <div class="text-center">
                <p class="text-3xl font-bold text-secondary">Running</p>
                <p class="text-default-500">System Status</p>
            </div>
        </LumexCardBody>
    </LumexCard>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
    <LumexCard>
        <LumexCardHeader>
            <p class="text-lg font-semibold">LLM Providers</p>
        </LumexCardHeader>
        <LumexDivider />
        <LumexCardBody>
            <div class="space-y-2">
                @foreach (var provider in Orchestrator.GetAvailableProviders())
                {
                    <div class="flex items-center justify-between py-2 px-3 rounded-lg bg-default-50">
                        <span>@provider</span>
                        <LumexChip Color="ThemeColor.Success" Size="Size.Small">Active</LumexChip>
                    </div>
                }
            </div>
        </LumexCardBody>
    </LumexCard>

    <LumexCard>
        <LumexCardHeader>
            <p class="text-lg font-semibold">Available Skills</p>
        </LumexCardHeader>
        <LumexDivider />
        <LumexCardBody>
            <div class="space-y-2">
                @foreach (var skill in Orchestrator.GetAvailableSkills())
                {
                    <div class="py-2 px-3 rounded-lg bg-default-50">
                        @skill
                    </div>
                }
            </div>
        </LumexCardBody>
    </LumexCard>
</div>

<LumexCard>
    <LumexCardHeader>
        <p class="text-lg font-semibold">Quick Actions</p>
    </LumexCardHeader>
    <LumexDivider />
    <LumexCardBody>
        <div class="flex flex-wrap gap-2">
            <LumexLink Href="/"><LumexButton Color="ThemeColor.Primary">Start Chat</LumexButton></LumexLink>
            <LumexButton Color="ThemeColor.Default" Variant="Variant.Outlined">View Logs</LumexButton>
            <LumexButton Color="ThemeColor.Secondary" Variant="Variant.Outlined">Configure Providers</LumexButton>
            <LumexButton Color="ThemeColor.Success" Variant="Variant.Outlined">Manage Skills</LumexButton>
        </div>
    </LumexCardBody>
</LumexCard>
