@page "/dashboard"
@using Atlas.Core
@rendermode InteractiveServer
@inject AtlasOrchestrator Orchestrator

<PageTitle>Dashboard - ATLAS Assistant</PageTitle>

<h1 class="mb-4">ATLAS Dashboard</h1>

<div class="row">
    <div class="col-md-6 mb-4">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Available LLM Providers</h5>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    @foreach (var provider in Orchestrator.GetAvailableProviders())
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            @provider
                            <span class="badge bg-success rounded-pill">Active</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-4">
        <div class="card">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">Available Skills</h5>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    @foreach (var skill in Orchestrator.GetAvailableSkills())
                    {
                        <li class="list-group-item">
                            @skill
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">System Status</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        <div class="text-center p-3 border rounded">
                            <h3 class="text-primary">@Orchestrator.GetAvailableProviders().Count()</h3>
                            <p class="mb-0">Active Providers</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-center p-3 border rounded">
                            <h3 class="text-success">@Orchestrator.GetAvailableSkills().Count()</h3>
                            <p class="mb-0">Available Skills</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-center p-3 border rounded">
                            <h3 class="text-info">Running</h3>
                            <p class="mb-0">System Status</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-warning">
                <h5 class="mb-0">Quick Actions</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2 d-md-flex">
                    <a href="/chat" class="btn btn-primary">Start Chat</a>
                    <button class="btn btn-secondary">View Logs</button>
                    <button class="btn btn-info">Configure Providers</button>
                    <button class="btn btn-success">Manage Skills</button>
                </div>
            </div>
        </div>
    </div>
</div>
