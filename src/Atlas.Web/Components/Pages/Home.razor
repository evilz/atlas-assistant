@page "/"
@using Atlas.Core
@rendermode InteractiveServer
@inject AtlasOrchestrator Orchestrator
@inject ILogger<Home> Logger

<PageTitle>ATLAS Assistant</PageTitle>

<div class="flex flex-col h-[calc(100vh-7rem)]">
    <div class="flex items-center justify-between px-4 py-3 border-b border-divider">
        <h1 class="text-xl font-semibold">ATLAS Assistant</h1>
        <div class="w-64">
            <LumexSelect TValue="string"
                         Label="CLI Agent"
                         Placeholder="Select an agent"
                         Variant="InputVariant.Outlined"
                         @bind-Value="selectedProvider">
                @foreach (var provider in Orchestrator.GetAvailableProviders())
                {
                    <LumexSelectItem TValue="string" Value="@provider">@provider</LumexSelectItem>
                }
            </LumexSelect>
        </div>
    </div>

    <div class="flex-1 overflow-y-auto p-4 space-y-4">
        @if (messages.Count == 0)
        {
            <div class="flex flex-col items-center justify-center h-full text-default-400">
                <svg class="w-16 h-16 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                          d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                </svg>
                <p class="text-lg font-medium">Start a conversation</p>
                <p class="text-sm">Select a CLI agent above and type your message below.</p>
            </div>
        }
        else
        {
            @foreach (var msg in messages)
            {
                <div class="flex @(msg.IsUser ? "justify-end" : "justify-start")">
                    <div class="max-w-[70%] rounded-2xl px-4 py-2 @(msg.IsUser ? "bg-primary text-primary-foreground" : "bg-default-100 text-foreground")">
                        <p class="text-xs font-semibold mb-1 opacity-70">@(msg.IsUser ? "You" : selectedProvider ?? "ATLAS")</p>
                        <p class="whitespace-pre-wrap">@msg.Content</p>
                    </div>
                </div>
            }
            @if (isProcessing)
            {
                <div class="flex justify-start">
                    <div class="max-w-[70%] rounded-2xl px-4 py-2 bg-default-100 text-foreground">
                        <LumexSpinner Size="Size.Small" />
                    </div>
                </div>
            }
        }
    </div>

    <div class="px-4 py-3 border-t border-divider">
        <div class="flex gap-2 items-end">
            <div class="flex-1">
                <LumexTextbox @bind-Value="currentMessage"
                              Placeholder="Type your message..."
                              Variant="InputVariant.Outlined"
                              Disabled="@isProcessing"
                              @onkeydown="HandleKeyDown" />
            </div>
            <LumexButton Color="ThemeColor.Primary"
                         Disabled="@(isProcessing || string.IsNullOrWhiteSpace(currentMessage))"
                         OnClick="SendMessage">
                Send
            </LumexButton>
        </div>
    </div>
</div>

@code {
    private readonly List<ChatMessage> messages = new();
    private string? currentMessage;
    private string? selectedProvider;
    private bool isProcessing;

    private class ChatMessage
    {
        public string Content { get; set; } = string.Empty;
        public bool IsUser { get; set; }
    }

    protected override void OnInitialized()
    {
        selectedProvider = Orchestrator.GetAvailableProviders().FirstOrDefault();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !isProcessing && !string.IsNullOrWhiteSpace(currentMessage))
        {
            await SendMessage();
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(currentMessage) || isProcessing)
            return;

        var userMessage = currentMessage;
        currentMessage = string.Empty;

        messages.Add(new ChatMessage { Content = userMessage, IsUser = true });
        isProcessing = true;
        StateHasChanged();

        try
        {
            var response = await Orchestrator.ProcessMessageAsync(userMessage, selectedProvider);
            messages.Add(new ChatMessage { Content = response, IsUser = false });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error processing message");
            messages.Add(new ChatMessage { Content = $"Error: {ex.Message}", IsUser = false });
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }
}
