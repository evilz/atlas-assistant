@using Atlas.Core
@inherits LayoutComponentBase
@inject AtlasOrchestrator Orchestrator

<LumexNavbar Bordered="@true"
             Sticky="@true"
             Classes="@_navbarClasses">
    <LumexNavbarBrand>
        <span class="font-bold text-xl">
            Atlas<span class="font-normal"> Assistant</span>
        </span>
    </LumexNavbarBrand>

    <LumexNavbarContent Class="hidden sm:flex">
        <LumexNavbarItem>
            <LumexLink Href="/examples/navbar/custom-styles#"
                       Color="@ThemeColor.None"
                       Class="px-4 py-1.5">
                Home
            </LumexLink>
        </LumexNavbarItem>
        <LumexNavbarItem>
            <LumexLink Href="/examples/navbar/custom-styles#"
                       Color="@ThemeColor.None"
                       Class="px-4 py-1.5">
                About
            </LumexLink>
        </LumexNavbarItem>
    </LumexNavbarContent>

    <LumexNavbarContent Align="@Align.End">
        <LumexDropdown>
            <LumexDropdownTrigger>
                <LumexButton Color="ThemeColor.Default"
                             Variant="Variant.Flat">
                    @selectedProvider
                </LumexButton>
            </LumexDropdownTrigger>
            <LumexDropdownMenu Color="ThemeColor.Default" Variant="MenuVariant.Flat">
                @foreach (var provider in Orchestrator.GetAvailableProviders())
                {
                    <LumexDropdownItem TValue="string" Value="@provider">@provider</LumexDropdownItem>
                }
               
            </LumexDropdownMenu>
        </LumexDropdown>
        
     
    </LumexNavbarContent>
</LumexNavbar>
<div class="flex min-h-screen">
    
    

    
    <div class="sidebar w-64 bg-content1 border-r border-divider hidden md:block">
        <NavMenu/>
    </div>

    <main class="flex-1 flex flex-col">
        <header class="flex items-center justify-between px-4 py-2 border-b border-divider bg-content1">
            <span class="md:hidden font-semibold text-lg">ATLAS</span>
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank"
               class="text-sm text-primary hover:underline ml-auto">About</a>
        </header>

        <article class="flex-1 p-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>


@code {
    private string? selectedProvider;
    
    protected override void OnInitialized()
    {
        selectedProvider = Orchestrator.GetAvailableProviders().FirstOrDefault();
    }
    
    private NavbarSlots _navbarClasses = new()
    {
        Base = "border-b-2 border-default-100",
        Brand = "bg-clip-text bg-gradient-to-r from-foreground-900 to-foreground-600 text-transparent",
        Content = "gap-3",
        Item = "rounded-lg font-medium text-foreground bg-default-100 dark:bg-default-50"
    };

    private InputFieldSlots _inputClasses = new()
    {
        Base = "max-w-full sm:max-w-[10rem] h-8",
        Input = "text-tiny"
    };
}